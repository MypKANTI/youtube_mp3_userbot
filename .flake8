# ==============================================================================
# ВНИМАНИЕ: этот файл сгенерирован с помощью ИИ.
# Я не писал его вручную и не гарантирую, что каждая опция здесь оптимальна
# или что я понимаю все нюансы. Файл включён в проект для портфолио как есть,
# чтобы было видно, с какими инструментами я работаю и как их настраиваю.
# Если вы читаете это как ревьюер — воспринимайте конфиг как «рабочий
# разумный дефолт», а не как плод моей глубокой экспертизы по flake8.
# ==============================================================================

[flake8]
# Максимальная длина строки, совместимая с black по умолчанию.
max-line-length = 79

# Коды, которые конфликтуют с форматированием black:
# E203 — пробел перед ':' (black форматирует срезы иначе)
# W503 — перенос строки перед бинарным оператором
# E501 — длину строки контролирует black, а не flake8
extend-ignore = E203, W503, E501

# Служебные директории и файлы, которые не нужно проверять.
exclude =
    .git,
    .venv,
    venv,
    __pycache__,
    .mypy_cache,
    .pytest_cache,
    build,
    dist,
    *.egg-info,
    migrations

# Максимальная цикломатическая сложность функции.
max-complexity = 10
